<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mecanicacassoni.controller.FuncionarioController">
   <children>
      <Label layoutX="60.0" layoutY="94.0" text="ID:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="60.0" layoutY="134.0" text="NOME:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtId" layoutX="94.0" layoutY="93.0" />
      <TextField fx:id="txtNome" layoutX="133.0" layoutY="133.0" />
      <Button layoutX="57.0" layoutY="171.0" mnemonicParsing="false" onAction="#inserirFuncionario" text="Inserir">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="142.0" layoutY="171.0" mnemonicParsing="false" onAction="#atualizarFuncionario" text="Atualizar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="57.0" layoutY="221.0" mnemonicParsing="false" onAction="#deletarFuncionario" text="Deletar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="148.0" layoutY="221.0" mnemonicParsing="false" onAction="#buscarFuncionarioPorId" text="Buscar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <TableView fx:id="tabelaFuncionarios" layoutX="355.0" layoutY="49.0" prefHeight="365.0" prefWidth="380.0">
        <columns>
          <TableColumn fx:id="colunaId" prefWidth="93.0" text="ID" />
          <TableColumn fx:id="colunaNome" prefWidth="286.0" text="NOME" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
