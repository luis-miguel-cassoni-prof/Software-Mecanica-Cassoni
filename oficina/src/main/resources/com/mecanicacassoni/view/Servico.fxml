<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mecanicacassoni.controller.ServicoController">
   <children>
      <Label layoutX="14.0" layoutY="112.0" text="ID:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="147.0" text="NOME:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtId" layoutX="46.0" layoutY="111.0" prefHeight="25.0" prefWidth="85.0" />
      <TextField fx:id="txtNome" layoutX="87.0" layoutY="146.0" prefHeight="25.0" prefWidth="202.0" />
      <Button layoutX="57.0" layoutY="287.0" mnemonicParsing="false" onAction="#inserirServico" text="Inserir">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="142.0" layoutY="287.0" mnemonicParsing="false" onAction="#atualizarServico" text="Atualizar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="53.0" layoutY="336.0" mnemonicParsing="false" onAction="#deletarServico" text="Deletar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="151.0" layoutY="336.0" mnemonicParsing="false" onAction="#buscarServicoPorId" text="Buscar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <TableView fx:id="tabelaServicos" layoutX="304.0" layoutY="36.0" prefHeight="428.0" prefWidth="471.0">
        <columns>
          <TableColumn fx:id="colunaId" prefWidth="93.0" text="ID" />
          <TableColumn fx:id="colunaNome" prefWidth="126.0" text="SERVIÇO" />
            <TableColumn fx:id="colunaCliente" prefWidth="142.0" text="CLIENTE" />
            <TableColumn fx:id="colunaValorTotal" prefWidth="109.0" text="VALOR TOTAL" />
        </columns>
      </TableView>
      <Label layoutX="11.0" layoutY="175.0" text="CLIENTE:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboClientes" layoutX="114.0" layoutY="174.0" prefHeight="25.0" prefWidth="175.0" />
      <Button layoutX="51.0" layoutY="386.0" mnemonicParsing="false" onAction="#acessarPrestacoes" text="Acessar Prestações">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Label layoutX="27.0" layoutY="210.0">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="210.0" text="VALOR:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtValor" layoutX="104.0" layoutY="209.0" prefHeight="25.0" prefWidth="121.0" />
