          <TableColumn fx:id="colunaNome" prefWidth="194.0" text="NOME" />
            <TableColumn fx:id="colunaCpf" prefWidth="183.0" text="CPF" />
        </columns>
      </TableView>
      <Label layoutX="61.0" layoutY="175.0" text="CPF:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtCpf" layoutX="115.0" layoutY="174.0" prefHeight="25.0" prefWidth="185.0" />
      <Button layoutX="15.0" layoutY="17.0" mnemonicParsing="false" onAction="#voltarMenu" prefHeight="0.0" prefWidth="72.0" text="Voltar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
