<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mecanicacassoni.controller.ClienteController">
   <children>
      <Label layoutX="60.0" layoutY="94.0" text="ID:">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="37.0" layoutY="134.0" text="NOME: ">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtId" layoutX="94.0" layoutY="93.0" />
      <TextField fx:id="txtNome" layoutX="111.0" layoutY="133.0" prefHeight="25.0" prefWidth="185.0" />
      <Button layoutX="51.0" layoutY="231.0" mnemonicParsing="false" onAction="#inserirCliente" text="Inserir">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="133.0" layoutY="231.0" mnemonicParsing="false" onAction="#atualizarCliente" text="Atualizar">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="53.0" layoutY="280.0" mnemonicParsing="false" onAction="#deletarCliente" text="Deletar">
         <font>
            <Font size="18.0" />
